# --- Database (MongoDB Atlas) ---
# Wajib replica set (Atlas sudah otomatis) karena persetujuan memakai transaksi.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/numora?retryWrites=true&w=majority

# --- Sesi ---
# Minimal 32 karakter acak. Contoh: openssl rand -base64 48
SESSION_SECRET=

# --- URL publik aplikasi (dipakai di tautan email undangan) ---
APP_URL=http://localhost:3000

# --- Mailer (Gmail + App Password, butuh 2FA aktif di akun Google) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM="NUMORA <no-reply@example.com>"
# Isi 1 untuk mematikan pengiriman (email dicetak ke console)
MAIL_DISABLED=0

# --- Seed Super Admin (dipakai oleh npm run db:init) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Pendaftaran instansi mandiri (/register). 1 = dibuka, selain itu ditutup ---
REGISTRATION_OPEN=0
