{
  "name": "numora",
  "version": "0.1.0",
  "private": true,
  "description": "NUMORA - Numbering, Simplified. Sistem penomoran surat multi-instansi.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "tsx --env-file=.env scripts/db-init.ts",
    "test:concurrency": "tsx --env-file=.env scripts/concurrency-test.ts",
    "test:integration": "vitest run tests/integration",
    "backup": "tsx --env-file=.env scripts/backup.ts",
    "mail:check": "tsx --env-file=.env scripts/mail-check.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "mongoose": "^8.9.0",
    "next": "^15.1.0",
    "nodemailer": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
